# Route AWS CLI and SDK calls to MiniStack
export AWS_ENDPOINT_URL="http://localhost:4566"

# Default network and storage configuration for the local sandbox
export SUBNET_IDS="subnet-11aa,subnet-22bb"
export SIMULATION_BUCKET_NAME="my-test-bucket"
export SIMULATION_S3_ENDPOINT_URL="http://ministack:4566"

# Dummy credentials to prevent AWS CLI from complaining locally
export AWS_ACCESS_KEY_ID="test"
export AWS_SECRET_ACCESS_KEY="test"
export AWS_DEFAULT_REGION="us-east-1"
