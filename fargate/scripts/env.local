# Force AWS CLI and SDKs to route traffic to the local emulator
export AWS_ENDPOINT_URL="http://localhost:4566"

# Default network and storage configuration for LocalStack testing
export SUBNET_IDS="subnet-11aa,subnet-22bb"
export SIMULATION_BUCKET_NAME="my-test-bucket"
# Override if task containers need a different route to LocalStack than localhost.
# export SIMULATION_S3_ENDPOINT_URL="http://<task-reachable-host>:4566"

# Dummy credentials to prevent AWS CLI from complaining locally
export AWS_ACCESS_KEY_ID="test"
export AWS_SECRET_ACCESS_KEY="test"
export AWS_DEFAULT_REGION="us-east-1"
